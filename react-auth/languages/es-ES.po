#, fuzzy
msgid "Hint: The password should be at least %d character long. To make it stronger, use upper and lower case letters, numbers, and symbols like ! \" ? $ %% ^ & )."
msgid_plural "Hint: The password should be at least %d characters long. To make it stronger, use upper and lower case letters, numbers, and symbols like ! \" ? $ %% ^ & )."
msgstr[0] "Sugerencia: La contraseña debe ser de al menos %d carácter. Para hacerla más fuerte usa mayúsculas y minúsculas, números y símbolos como ! \" ? $ %% ^ y )."
msgstr[1] "Sugerencia: La contraseña debe ser de al menos %d de caracteres. Para hacerla más fuerte usa mayúsculas y minúsculas, números y símbolos como ! \" ? $ %% ^ y )."
msgstr[2] "Sugerencia: La contraseña debe ser de al menos %d caracteres. Para hacerla más fuerte usa mayúsculas y minúsculas, números y símbolos como ! \" ? $ %% ^ y )."

msgid "If that address has an account, a reset link is on its way."
msgstr "Si esa dirección tiene una cuenta, le llegará un enlace para restablecerla."

msgid "Important:"
msgstr "Importante:"

